@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "InventoryErp";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle · InventoryErp</title>
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('app-theme');
                var theme = stored
                    || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-bs-theme', theme);
            } catch (e) {
                document.documentElement.setAttribute('data-bs-theme', 'light');
            }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InventoryErp.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @* Signed-out shell: no sidebar or app nav, since every link in it would bounce
       straight back to the login page. *@
    <partial name="_IconSprite" />

    <div class="auth">
        <div class="auth__panel">
            <div class="auth__brand">
                <span class="app-sidebar__mark" aria-hidden="true">IE</span>
                <span>InventoryErp</span>
            </div>

            <div class="auth__card">
                @RenderBody()
            </div>

            <p class="auth__footer">&copy; @DateTime.UtcNow.Year InventoryErp</p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
