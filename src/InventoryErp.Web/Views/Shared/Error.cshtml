@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    // Auth layout: an error can be reached signed out, and the app shell's nav would be
    // useless (or misleading) in that case.
    Layout = "_AuthLayout";
}

<div class="text-center">
    <div class="empty-state__icon mb-3">
        <svg class="icon icon-lg text-danger" aria-hidden="true"><use href="#i-alert" /></svg>
    </div>
    <h1 class="auth__title">Something went wrong</h1>
    <p class="auth__subtitle">
        An error occurred while processing your request. Please try again.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="form-hint">
            Request ID: <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-primary w-100 mt-2" asp-controller="Home" asp-action="Index">
        <svg class="icon" aria-hidden="true"><use href="#i-arrow-left" /></svg>
        Back to dashboard
    </a>
</div>
