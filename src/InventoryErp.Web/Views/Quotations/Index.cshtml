@using InventoryErp.Web.Models
@model QuotationListViewModel
@{
    ViewData["Title"] = "Quotations";
    var list = Model.Page;
    var hasItems = list.Items.Count > 0;
    var from = hasItems ? ((list.PageNumber - 1) * list.PageSize) + 1 : 0;
    var to = from + list.Items.Count - 1;
    var pastEnd = !hasItems && list.TotalCount > 0;
}

<div class="page-header">
    <div>
        <h2 class="page-header__title">Quotations</h2>
        <p class="page-header__subtitle">
            @if (Model.LoadError is not null)
            {
                <span>—</span>
            }
            else if (!hasItems)
            {
                <span>No quotations</span>
            }
            else
            {
                <span>Showing @from–@to of @list.TotalCount</span>
            }
        </p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
        New quotation
    </a>
</div>

@if (Model.LoadError is not null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg>
        <div>@Model.LoadError</div>
    </div>
}
else
{
    <div class="card">
        @if (!hasItems)
        {
            @if (pastEnd)
            {
                <div class="empty-state">
                    <div class="empty-state__icon">
                        <svg class="icon icon-lg" aria-hidden="true"><use href="#i-inbox" /></svg>
                    </div>
                    <p class="empty-state__title">Page @list.PageNumber is empty</p>
                    <p class="empty-state__text">
                        There @(list.TotalCount == 1 ? "is" : "are") only @list.TotalCount
                        @(list.TotalCount == 1 ? "quotation" : "quotations") in this list.
                    </p>
                    <a class="btn btn-outline-secondary"
                       asp-action="Index" asp-route-page="1" asp-route-pageSize="@list.PageSize">
                        Back to first page
                    </a>
                </div>
            }
            else
            {
                <partial name="_EmptyState" model="@(new EmptyStateViewModel {
                    Icon = "i-file",
                    Title = "No quotations yet",
                    Message = "Create your first quotation to send a customer a price.",
                    ActionText = "New quotation",
                    ActionController = "Quotations",
                    ActionAction = "Create"
                })" />
            }
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Number</th>
                            <th scope="col">Customer</th>
                            <th scope="col">Date</th>
                            <th scope="col">Valid until</th>
                            <th scope="col" class="cell-numeric">Lines</th>
                            <th scope="col" class="cell-numeric">Total</th>
                            <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var quotation in list.Items)
                        {
                            <tr>
                                <td><code>@quotation.QuotationNumber</code></td>
                                <td>@quotation.CustomerName</td>
                                <td>@quotation.QuotationDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (quotation.ValidUntil is null)
                                    {
                                        <span class="text-muted-app">No expiry</span>
                                    }
                                    else
                                    {
                                        <span>@quotation.ValidUntil.Value.ToString("dd MMM yyyy")</span>
                                    }
                                </td>
                                <td class="cell-numeric text-muted-app">@quotation.LineCount</td>
                                <td class="cell-numeric fw-semibold">@quotation.TotalAmount.ToString("N2")</td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Details" asp-route-id="@quotation.Id">
                                            View
                                        </a>
                                        <a class="btn btn-sm btn-outline-secondary btn-icon"
                                           asp-action="Pdf" asp-route-id="@quotation.Id" target="_blank"
                                           aria-label="PDF for @quotation.QuotationNumber" title="Download PDF">
                                            <svg class="icon icon-sm" aria-hidden="true"><use href="#i-file" /></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (list.TotalPages > 1)
            {
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <span class="text-muted-app small">Page @list.PageNumber of @list.TotalPages</span>
                    <nav aria-label="Quotation pages">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(list.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(list.PageNumber - 1)"
                                   asp-route-pageSize="@list.PageSize">Previous</a>
                            </li>
                            <li class="page-item @(list.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(list.PageNumber + 1)"
                                   asp-route-pageSize="@list.PageSize">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
}
