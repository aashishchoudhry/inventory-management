@using InventoryErp.Application.DTOs.Dashboard
@using InventoryErp.Web.Models
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var stats = Model.Stats;
}

<div class="page-header">
    <div>
        <h2 class="page-header__title">Dashboard</h2>
        <p class="page-header__subtitle">Your business at a glance</p>
    </div>
    <div class="action-bar">
        <a class="btn btn-outline-secondary" asp-controller="Quotations" asp-action="Create">
            <svg class="icon" aria-hidden="true"><use href="#i-file" /></svg>
            New quotation
        </a>
        <a class="btn btn-primary" asp-controller="Products" asp-action="Create">
            <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
            New product
        </a>
    </div>
</div>

@if (Model.LoadError is not null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg>
        <div>@Model.LoadError</div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <a class="card stat-tile text-decoration-none" asp-controller="Products" asp-action="Index">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-tile__icon">
                        <svg class="icon icon-lg" aria-hidden="true"><use href="#i-box" /></svg>
                    </div>
                    <div>
                        <p class="stat-tile__label">Products</p>
                        <div class="stat-tile__value">@stats.ProductCount</div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-6 col-xl-3">
            <a class="card stat-tile text-decoration-none" asp-controller="Customers" asp-action="Index">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-tile__icon">
                        <svg class="icon icon-lg" aria-hidden="true"><use href="#i-users" /></svg>
                    </div>
                    <div>
                        <p class="stat-tile__label">Customers</p>
                        <div class="stat-tile__value">@stats.CustomerCount</div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-6 col-xl-3">
            <a class="card stat-tile text-decoration-none" asp-controller="Quotations" asp-action="Index">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-tile__icon stat-tile__icon--ok">
                        <svg class="icon icon-lg" aria-hidden="true"><use href="#i-file" /></svg>
                    </div>
                    <div>
                        <p class="stat-tile__label">Quotations today</p>
                        <div class="stat-tile__value">@stats.QuotationsToday</div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-6 col-xl-3">
            <a class="card stat-tile text-decoration-none" asp-controller="Quotations" asp-action="Index">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-tile__icon @(stats.QuotationsExpiringSoon > 0 ? "stat-tile__icon--warn" : "")">
                        <svg class="icon icon-lg" aria-hidden="true"><use href="#i-alert" /></svg>
                    </div>
                    <div>
                        <p class="stat-tile__label">
                            Expiring in @DashboardStatsDto.ExpiringWindowDays days
                        </p>
                        <div class="stat-tile__value">@stats.QuotationsExpiringSoon</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    @* Not a KPI — the reorder queue. Kept from the previous dashboard because it is the one
       thing here that prompts action rather than reporting a number. *@
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span>Needs reordering</span>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="Products" asp-action="Index">
                View all products
            </a>
        </div>

        @if (Model.LowStockProducts.Count == 0)
        {
            <partial name="_EmptyState" model="@(new EmptyStateViewModel {
                Icon = "i-check",
                Title = "Everything is stocked",
                Message = "No products are at or below their reorder level."
            })" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">SKU</th>
                            <th scope="col">Name</th>
                            <th scope="col" class="cell-numeric">In stock</th>
                            <th scope="col" class="cell-numeric">Reorder at</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.LowStockProducts)
                        {
                            <tr>
                                <td><code>@product.Sku</code></td>
                                <td>@product.Name</td>
                                <td class="cell-numeric">
                                    <span class="badge-pill badge-pill--warn">@product.CurrentStock</span>
                                </td>
                                <td class="cell-numeric text-muted-app">@product.ReorderLevel</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id">
                                        Restock
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
