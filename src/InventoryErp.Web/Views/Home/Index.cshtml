@using InventoryErp.Web.Models
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h2 class="page-header__title">Dashboard</h2>
        <p class="page-header__subtitle">Inventory at a glance</p>
    </div>
    <a class="btn btn-primary" asp-controller="Products" asp-action="Create">
        <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
        New product
    </a>
</div>

@if (Model.LoadError is not null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg>
        <div>Could not load dashboard data: @Model.LoadError</div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card stat-tile">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-tile__icon">
                        <svg class="icon icon-lg" aria-hidden="true"><use href="#i-box" /></svg>
                    </div>
                    <div>
                        <p class="stat-tile__label">Total products</p>
                        <div class="stat-tile__value">@Model.TotalProducts</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card stat-tile">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-tile__icon stat-tile__icon--ok">
                        <svg class="icon icon-lg" aria-hidden="true"><use href="#i-check" /></svg>
                    </div>
                    <div>
                        <p class="stat-tile__label">Active</p>
                        <div class="stat-tile__value">@Model.ActiveProducts</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card stat-tile">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-tile__icon stat-tile__icon--warn">
                        <svg class="icon icon-lg" aria-hidden="true"><use href="#i-alert" /></svg>
                    </div>
                    <div>
                        <p class="stat-tile__label">Below reorder level</p>
                        <div class="stat-tile__value">@Model.LowStockCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card stat-tile">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-tile__icon">
                        <svg class="icon icon-lg" aria-hidden="true"><use href="#i-currency" /></svg>
                    </div>
                    <div>
                        <p class="stat-tile__label">Stock value</p>
                        <div class="stat-tile__value">@Model.InventoryValue.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span>Needs reordering</span>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="Products" asp-action="Index">
                View all products
            </a>
        </div>

        @if (Model.LowStockProducts.Count == 0)
        {
            <partial name="_EmptyState" model="@(new EmptyStateViewModel {
                Icon = "i-check",
                Title = "Everything is stocked",
                Message = "No products are at or below their reorder level."
            })" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">SKU</th>
                            <th scope="col">Name</th>
                            <th scope="col" class="cell-numeric">In stock</th>
                            <th scope="col" class="cell-numeric">Reorder at</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.LowStockProducts)
                        {
                            <tr>
                                <td><code>@product.Sku</code></td>
                                <td>@product.Name</td>
                                <td class="cell-numeric">
                                    <span class="badge-pill badge-pill--warn">@product.CurrentStock</span>
                                </td>
                                <td class="cell-numeric text-muted-app">@product.ReorderLevel</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id">
                                        Restock
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
