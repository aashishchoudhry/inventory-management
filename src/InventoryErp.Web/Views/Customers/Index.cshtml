@using InventoryErp.Web.Models
@model CustomerListViewModel
@{
    ViewData["Title"] = "Customers";
    var list = Model.Page;
    var hasItems = list.Items.Count > 0;
    // Derived from the items actually present, so a page past the end cannot produce
    // a nonsense range such as "Showing 21–7 of 7".
    var from = hasItems ? ((list.PageNumber - 1) * list.PageSize) + 1 : 0;
    var to = from + list.Items.Count - 1;
    var pastEnd = !hasItems && list.TotalCount > 0;
}

<div class="page-header">
    <div>
        <h2 class="page-header__title">Customers</h2>
        <p class="page-header__subtitle">
            @if (Model.LoadError is not null)
            {
                <span>—</span>
            }
            else if (!hasItems)
            {
                <span>No customers</span>
            }
            else
            {
                <span>Showing @from–@to of @list.TotalCount</span>
            }
        </p>
    </div>
</div>

@if (Model.LoadError is not null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg>
        <div>@Model.LoadError</div>
    </div>
}
else
{
    <div class="card">
        @if (!hasItems)
        {
            @if (pastEnd)
            {
                <div class="empty-state">
                    <div class="empty-state__icon">
                        <svg class="icon icon-lg" aria-hidden="true"><use href="#i-inbox" /></svg>
                    </div>
                    <p class="empty-state__title">Page @list.PageNumber is empty</p>
                    <p class="empty-state__text">
                        There @(list.TotalCount == 1 ? "is" : "are") only @list.TotalCount
                        @(list.TotalCount == 1 ? "customer" : "customers") in this list.
                    </p>
                    <a class="btn btn-outline-secondary"
                       asp-action="Index" asp-route-page="1" asp-route-pageSize="@list.PageSize">
                        Back to first page
                    </a>
                </div>
            }
            else
            {
                <partial name="_EmptyState" model="@(new EmptyStateViewModel {
                    Icon = "i-users",
                    Title = "No customers yet",
                    Message = "Customers will appear here once they are added."
                })" />
            }
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Code</th>
                            <th scope="col">Mobile</th>
                            <th scope="col">City</th>
                            <th scope="col">State</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in list.Items)
                        {
                            <tr>
                                <td>@customer.Name</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(customer.Code))
                                    {
                                        <span class="text-muted-app">—</span>
                                    }
                                    else
                                    {
                                        <code>@customer.Code</code>
                                    }
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(customer.Mobile))
                                    {
                                        <span class="text-muted-app">—</span>
                                    }
                                    else
                                    {
                                        <span>@customer.Mobile</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(customer.City) ? "—" : customer.City)</td>
                                <td>@(string.IsNullOrWhiteSpace(customer.State) ? "—" : customer.State)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (list.TotalPages > 1)
            {
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <span class="text-muted-app small">Page @list.PageNumber of @list.TotalPages</span>
                    <nav aria-label="Customer pages">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(list.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(list.PageNumber - 1)"
                                   asp-route-pageSize="@list.PageSize">Previous</a>
                            </li>
                            <li class="page-item @(list.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(list.PageNumber + 1)"
                                   asp-route-pageSize="@list.PageSize">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
}
