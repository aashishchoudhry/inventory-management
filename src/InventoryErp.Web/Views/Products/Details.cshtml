@using InventoryErp.Application.DTOs.Products
@model ProductDto
@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>

<dl class="row">
    <dt class="col-sm-3">SKU</dt>
    <dd class="col-sm-9">@Model.Sku</dd>

    <dt class="col-sm-3">Barcode</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Barcode) ? "—" : Model.Barcode)</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>

    <dt class="col-sm-3">Selling price</dt>
    <dd class="col-sm-9">@Model.SellingPrice.ToString("N2")</dd>

    <dt class="col-sm-3">GST %</dt>
    <dd class="col-sm-9">@Model.GstPercent.ToString("N2")</dd>

    <dt class="col-sm-3">Current stock</dt>
    <dd class="col-sm-9">@Model.CurrentStock</dd>

    <dt class="col-sm-3">Reorder level</dt>
    <dd class="col-sm-9">@Model.ReorderLevel</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn btn-link" asp-action="Index">Back to list</a>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
    <button type="submit" class="btn btn-outline-danger">Delete</button>
</form>
