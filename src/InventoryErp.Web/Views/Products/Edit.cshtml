@using InventoryErp.Application.DTOs.Products
@model UpdateProductRequest
@{
    ViewData["Title"] = "Edit product";
}

<div class="page-header">
    <div>
        <h2 class="page-header__title">Edit product</h2>
        <p class="page-header__subtitle">@Model.Name</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">
        <svg class="icon" aria-hidden="true"><use href="#i-arrow-left" /></svg>
        Back to products
    </a>
</div>

<form asp-action="Edit" method="post" data-busy-submit>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CompanyId" />

    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <div class="card">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-section">
                        <p class="form-section__title">Identification</p>
                        <p class="form-section__hint">SKU must be unique within the company.</p>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Sku" class="form-label"></label>
                                <input asp-for="Sku" class="form-control" />
                                <span asp-validation-for="Sku" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Barcode" class="form-label"></label>
                                <input asp-for="Barcode" class="form-control" placeholder="Optional" />
                                <span asp-validation-for="Barcode" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <p class="form-section__title">Pricing</p>
                        <p class="form-section__hint">GST is a percentage — enter 18 for 18%.</p>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="SellingPrice" class="form-label"></label>
                                <input asp-for="SellingPrice" class="form-control" />
                                <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="GstPercent" class="form-label"></label>
                                <input asp-for="GstPercent" class="form-control" />
                                <span asp-validation-for="GstPercent" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <p class="form-section__title">Stock</p>
                        <p class="form-section__hint">
                            A product is flagged for reorder when stock is at or below the reorder level.
                        </p>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="CurrentStock" class="form-label"></label>
                                <input asp-for="CurrentStock" class="form-control" />
                                <span asp-validation-for="CurrentStock" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="ReorderLevel" class="form-label"></label>
                                <input asp-for="ReorderLevel" class="form-control" />
                                <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card mb-3">
                <div class="card-header">Settings</div>
                <div class="card-body">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<InventoryErp.Domain.Enums.ProductStatus>()"
                            class="form-select"></select>
                </div>
            </div>

            <div class="card">
                <div class="card-body action-bar">
                    <button type="submit" class="btn btn-primary">
                        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
                        Save changes
                    </button>
                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
